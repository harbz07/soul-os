{
  "gateway": "soul-os-api",
  "domain": "api.soul-os.cc",
  "status": "operational",
  "version": "2.0.0",
  "description": "Constellation API Gateway",
  "upstream": "siddartha (service binding)",
  "routes": {
    "GET  /": "This manifest",
    "GET  /health": "Gateway + upstream health",
    "GET  /waypoints": "Siddhartha waypoint registry",
    "GET  /mailbox/:agent": "Siddhartha agent mailbox",
    "POST /mailbox/:agent/ack": "Acknowledge a mailbox message",
    "POST /mailbox/:agent/clear": "Clear mailbox messages",
    "POST /v1/chat/completions": "Siddhartha OpenAI-compatible chat",
    "POST /api/route": "Siddhartha memory-hydrated agent call (Coleco-mediated)",
    "POST /dispatch": "Siddhartha passage dispatch",
    "POST /message": "Siddhartha inter-agent message",
    "POST /reply": "Siddhartha inter-agent reply",
    "POST /chain": "Siddhartha multi-hop chain",
    "POST /parietal": "Siddhartha semantic gravity",
    "POST /log": "Siddhartha atlas session log",
    "POST /converse": "Siddhartha multi-agent conversation",
    "POST /thread": "Open or retrieve a conversation thread",
    "GET  /thread/:id": "Thread + traces + graph",
    "GET  /thread/:id/graph": "Conversation graph for a thread",
    "GET  /threads": "List all threads",
    "GET  /graph/:agent": "Agent's full graph across all threads",
    "GET  /sessions": "List recent sessions",
    "GET  /session/:id": "Session + its traces",
    "GET  /agents/state": "All agent state snapshots",
    "POST /debate": "Run a PvE structured debate via MindBridge Router",
    "GET  /debates": "List all debate records",
    "GET  /debate/:id": "Retrieve a single debate record"
  }
}